---
export const prerender = false;

import { blogPosts } from '../../data/blogPosts.js';
import { isRequestAuthenticated, getAdminPassword, createSessionToken, buildAuthCookie } from '../../lib/admin/auth';

const isAuthenticated = isRequestAuthenticated(Astro.request);
let passwordWrong = false;

if (Astro.request.method === 'POST') {
  const body = await Astro.request.formData();
  const password = body.get('password');
  if (password === getAdminPassword()) {
    const token = createSessionToken();
    const headers = new Headers();
    headers.append('Set-Cookie', 'rege_admin=ok; Path=/; HttpOnly; Max-Age=86400');
    headers.append('Set-Cookie', buildAuthCookie(token));
    headers.append('Location', '/admin/blog');
    return new Response(null, {
      status: 302,
      headers,
    });
  } else {
    passwordWrong = true;
  }
}

const featuredPost = blogPosts.find(p => p && p.featured);
const gridPosts = blogPosts.filter(p => p && !p.featured);
const delayClasses = ['', 'v2-reveal-delay-1', 'v2-reveal-delay-2'];
const allTags = Array.from(new Set(blogPosts.map(p => p?.tag).filter(Boolean)));
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin — Blog | Regê Engenharia</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700;800;900&family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400;1,600&display=swap" rel="stylesheet" />
</head>
<body>

{!isAuthenticated ? (
  <div class="admin-login-page">
    <div class="admin-login-card">
      <div class="admin-login-logo">
        <svg width="36" height="36" viewBox="0 0 36 36" fill="none">
          <rect width="36" height="36" rx="8" fill="#C9A84C"/>
          <path d="M10 26V10h6.5c2.5 0 4.5 2 4.5 4.5S19 19 16.5 19H10M18 26l5-8" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span>Regê Admin</span>
      </div>
      <h1>Área Restrita</h1>
      <p>Digite a senha para acessar o painel de edição do blog.</p>
      {passwordWrong && <div class="admin-login-error">Senha incorreta. Tente novamente.</div>}
      <form method="POST" class="admin-login-form">
        <div class="admin-login-field">
          <label for="password">Senha</label>
          <input type="password" id="password" name="password" placeholder="••••••••" required autofocus />
        </div>
        <button type="submit" class="admin-login-btn">Entrar</button>
      </form>
    </div>
  </div>
) : (
  <div>
    <!-- TOPBAR -->
    <div class="admin-topbar">
      <div class="admin-topbar-inner">
        <div class="admin-topbar-brand">
          <svg width="20" height="20" viewBox="0 0 36 36" fill="none">
            <rect width="36" height="36" rx="8" fill="#C9A84C"/>
            <path d="M10 26V10h6.5c2.5 0 4.5 2 4.5 4.5S19 19 16.5 19H10M18 26l5-8" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span>Admin — Blog Regê</span>
        </div>
        <div class="admin-topbar-links">
          <a href="/admin" class="admin-topbar-btn admin-topbar-btn-secondary">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
            ← Painel Geral
          </a>
          <a href="/blog" target="_blank" class="admin-topbar-btn admin-topbar-btn-ghost">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            Ver Blog Público
          </a>
          <a href="/admin/logout" class="admin-topbar-btn admin-topbar-btn-logout">Sair</a>
        </div>
      </div>
    </div>

    <!-- HERO -->
    <section class="blog-hero">
      <div class="blog-hero-bg">
        <img src="/images/hero-rege.avif" alt="Blog Regê Engenharia" />
        <div class="blog-hero-overlay"></div>
      </div>
      <div class="blog-hero-content v2-container">
        <div class="admin-mode-badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
          MODO EDIÇÃO ATIVO
        </div>
        <div class="blog-hero-badge">
          <span class="v2-badge-dot"></span>
          NOSSO BLOG
        </div>
        <h1 class="blog-hero-title">
          <span class="blog-title-line" style="animation-delay:0.3s">CONTEÚDOS E</span>
          <span class="blog-title-line blog-title-accent" style="animation-delay:0.45s">NOVIDADES</span>
          <span class="blog-title-line blog-title-stroke" style="animation-delay:0.6s">SOBRE OBRAS.</span>
        </h1>
        <p class="blog-hero-sub">
          Clique em <strong style="color: #C9A84C">Editar Artigo</strong> para alterar dados e imagem, ou <strong style="color: #C9A84C">Visualizar com Lápis</strong> para editar diretamente no layout real.
        </p>
      </div>
    </section>

    <!-- BARRA DE PESQUISA E FILTROS -->
    <div class="v2-container" style="margin-top: 2rem;">
      <div class="admin-blog-filter-bar">
        <div class="search-input-wrap">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          <input type="text" id="post-search" placeholder="Filtrar por título ou slug..." class="admin-search-field" />
        </div>
        <select id="tag-filter" class="admin-select-field">
          <option value="">Todas as categorias ({blogPosts.length})</option>
          {allTags.map(t => <option value={t}>{t}</option>)}
        </select>
      </div>
    </div>

    <section class="blog-section">
      <div class="v2-container">

        {featuredPost && (
          <div class="admin-post-wrapper admin-post-featured" data-title={(featuredPost.title || featuredPost.slug || '').toLowerCase()} data-slug={featuredPost.slug || ''} data-tag={featuredPost.tag || ''}>
            <div class="admin-card-actions">
              <a
                href={`/blog/${featuredPost.slug}`}
                target="_blank"
                class="admin-edit-btn admin-edit-btn-visual"
                title="Editar no layout real com lápis"
              >
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                Visualizar com Lápis
              </a>
              <button
                type="button"
                class="admin-edit-btn admin-edit-btn-modal"
                data-slug={featuredPost.slug}
                title="Editar dados completos do artigo"
              >
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                Editar Artigo
              </button>
            </div>
            <div class="blog-featured-post v2-reveal">
              <div class="blog-featured-img">
                <img src={featuredPost.image || '/images/hero-rege.avif'} alt={featuredPost.imageAlt || featuredPost.title || ''} />
              </div>
              <div class="blog-featured-text">
                <div class="blog-post-meta">
                  <span class="blog-post-tag">{featuredPost.tag || 'ENGENHARIA'}</span>
                  <span class="admin-featured-label">DESTAQUE</span>
                </div>
                <h2>{featuredPost.title || featuredPost.slug}</h2>
                <p class="blog-post-excerpt">{featuredPost.excerpt || ''}</p>
                <span class="blog-read-more">
                  <span>Ler Artigo Completo</span>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </span>
              </div>
            </div>
          </div>
        )}

        <div class="blog-grid" id="blog-grid">
          {gridPosts.map((post, i) => (
            <div class={`admin-post-wrapper v2-reveal ${delayClasses[i % 3]}`} data-title={(post.title || post.slug || '').toLowerCase()} data-slug={post.slug || ''} data-tag={post.tag || ''}>
              <div class="admin-card-actions">
                <a
                  href={`/blog/${post.slug}`}
                  target="_blank"
                  class="admin-edit-btn admin-edit-btn-visual"
                  title="Abrir no layout real para editar com o lápis"
                >
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                  Lápis Visual
                </a>
                <button
                  type="button"
                  class="admin-edit-btn admin-edit-btn-modal"
                  data-slug={post.slug}
                  title="Editar dados e texto do artigo"
                >
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                  Editar Artigo
                </button>
              </div>
              <div class="blog-card">
                <div class="blog-card-img">
                  <img src={post.image || '/images/hero-rege.avif'} alt={post.imageAlt || post.title || ''} />
                </div>
                <div class="blog-card-content">
                  <div class="blog-post-meta">
                    <span class="blog-post-tag">{post.tag || 'ENGENHARIA'}</span>
                  </div>
                  <h3>{post.title || post.slug}</h3>
                  <p>{post.excerpt || ''}</p>
                  <span class="blog-card-link">Ler mais</span>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- MODAL NATIVO DE EDIÇÃO DO ARTIGO -->
    <div id="article-modal" class="article-modal-backdrop" style="display: none;">
      <div class="article-modal-card">
        <div class="article-modal-header">
          <div>
            <span class="article-modal-tag">GERENCIADOR DE ARTIGO</span>
            <h3 id="modal-post-title">Editar Artigo</h3>
            <code id="modal-post-slug">slug-do-artigo</code>
          </div>
          <button id="modal-close-btn" class="article-modal-close">&times;</button>
        </div>

        <form id="post-edit-form" class="article-modal-body">
          <input type="hidden" id="edit-slug" />

          <div class="form-row">
            <div class="form-group flex-2">
              <label for="edit-title">Título do Artigo</label>
              <input type="text" id="edit-title" class="admin-input" required />
            </div>
            <div class="form-group flex-1">
              <label for="edit-tag">Categoria / Tag</label>
              <input type="text" id="edit-tag" class="admin-input" required />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group flex-2">
              <label for="edit-image">URL da Imagem de Capa</label>
              <input type="text" id="edit-image" class="admin-input" required />
            </div>
            <div class="form-group flex-1">
              <label for="edit-readtime">Tempo de Leitura</label>
              <input type="text" id="edit-readtime" class="admin-input" placeholder="ex: 5 min de leitura" />
            </div>
          </div>

          <div class="image-preview-bar">
            <img id="edit-image-preview" src="" alt="Capa" />
            <div class="image-upload-wrapper">
              <label class="btn-upload-file">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                <span>Fazer Upload de Imagem</span>
                <input type="file" id="edit-file-input" accept="image/png,image/jpeg,image/webp,image/avif" style="display: none;" />
              </label>
              <span id="edit-upload-status" class="upload-note">Formatos: PNG, JPG, WebP ou AVIF</span>
            </div>
          </div>

          <div class="form-group">
            <label for="edit-excerpt">Resumo do Post (Excerpt / Meta Description)</label>
            <textarea id="edit-excerpt" class="admin-textarea" rows="3" required></textarea>
          </div>

          <div class="form-group">
            <label class="checkbox-label">
              <input type="checkbox" id="edit-featured" />
              <span>Marcar este artigo como DESTAQUE na página inicial do blog</span>
            </label>
          </div>

          <div class="article-modal-footer">
            <button type="button" id="modal-cancel-btn" class="btn-ghost">Cancelar</button>
            <button type="submit" id="modal-save-btn" class="btn-gold-save">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L20 7"/></svg>
              <span>Salvar Alterações</span>
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- TOASTER DE SUCESSO -->
    <div id="blog-toast" class="blog-toast" style="display: none;">
      <span id="blog-toast-msg">Artigo salvo com sucesso!</span>
    </div>
  </div>
)}

<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: 'Outfit', sans-serif; background: #fff; color: #080E17; }

.admin-login-page {
  min-height: 100vh;
  background: linear-gradient(135deg, #080E17 0%, #12213B 100%);
  display: flex; align-items: center; justify-content: center;
  padding: 1.5rem;
}
.admin-login-card {
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(201,168,76,0.2);
  border-radius: 16px; padding: 3rem;
  width: 100%; max-width: 420px;
  backdrop-filter: blur(12px);
}
.admin-login-logo {
  display: flex; align-items: center; gap: 0.75rem;
  margin-bottom: 2rem; font-weight: 700; font-size: 1rem; color: #C9A84C;
}
.admin-login-card h1 { font-size: 1.5rem; font-weight: 800; color: #fff; margin-bottom: 0.5rem; }
.admin-login-card p { font-size: 0.875rem; color: rgba(255,255,255,0.5); margin-bottom: 2rem; line-height: 1.6; }
.admin-login-error {
  background: rgba(220,53,69,0.15); border: 1px solid rgba(220,53,69,0.3);
  color: #ff7b85; font-size: 0.8rem; padding: 0.75rem 1rem; border-radius: 8px; margin-bottom: 1.5rem;
}
.admin-login-form { display: flex; flex-direction: column; gap: 1.25rem; }
.admin-login-field { display: flex; flex-direction: column; gap: 0.5rem; }
.admin-login-field label {
  font-size: 0.75rem; font-weight: 700; letter-spacing: 1px;
  text-transform: uppercase; color: rgba(255,255,255,0.5);
}
.admin-login-field input {
  background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12);
  border-radius: 8px; padding: 0.875rem 1rem; font-size: 1rem;
  font-family: 'Outfit', sans-serif; color: #fff; outline: none; transition: border-color 0.2s;
}
.admin-login-field input:focus { border-color: #C9A84C; }
.admin-login-btn {
  background: #C9A84C; color: #080E17; font-family: 'Outfit', sans-serif;
  font-size: 0.875rem; font-weight: 700; letter-spacing: 1px; text-transform: uppercase;
  border: none; border-radius: 8px; padding: 1rem; cursor: pointer; transition: opacity 0.2s, transform 0.2s;
}
.admin-login-btn:hover { opacity: 0.85; transform: translateY(-1px); }

/* TOPBAR */
.admin-topbar {
  position: fixed; top: 0; left: 0; right: 0; height: 52px;
  background: #080E17; border-bottom: 1px solid rgba(201,168,76,0.3);
  z-index: 1000; display: flex; align-items: center; padding: 0 1.5rem;
}
.admin-topbar-inner {
  display: flex; align-items: center; justify-content: space-between;
  width: 100%; max-width: 1280px; margin: 0 auto;
}
.admin-topbar-brand {
  display: flex; align-items: center; gap: 0.6rem;
  font-weight: 700; font-size: 0.9rem; color: #fff;
}
.admin-topbar-brand span { color: #C9A84C; }
.admin-topbar-links { display: flex; align-items: center; gap: 0.75rem; }
.admin-topbar-btn {
  font-family: 'Outfit', sans-serif; font-size: 0.72rem; font-weight: 700;
  letter-spacing: 0.5px; text-decoration: none; padding: 0.45rem 0.85rem;
  border-radius: 6px; transition: all 0.2s; display: inline-flex; align-items: center; gap: 0.4rem;
}
.admin-topbar-btn-secondary { background: rgba(201,168,76,0.15); color: #C9A84C; border: 1px solid rgba(201,168,76,0.3); }
.admin-topbar-btn-secondary:hover { background: #C9A84C; color: #080E17; }
.admin-topbar-btn-ghost { color: rgba(255,255,255,0.6); }
.admin-topbar-btn-ghost:hover { color: #fff; }
.admin-topbar-btn-logout { background: rgba(220,53,69,0.15); color: #ff7b85; }
.admin-topbar-btn-logout:hover { background: #dc3545; color: #fff; }

.admin-mode-badge {
  display: inline-flex; align-items: center; gap: 0.5rem;
  background: rgba(201,168,76,0.2); border: 1px solid #C9A84C;
  color: #C9A84C; font-size: 0.65rem; font-weight: 800;
  letter-spacing: 1.5px; padding: 0.35rem 0.85rem; border-radius: 100px;
  margin-bottom: 1.5rem; width: fit-content;
}

.admin-post-wrapper { position: relative; }
.admin-featured-label {
  font-size: 0.62rem; font-weight: 700; letter-spacing: 1px;
  text-transform: uppercase; color: #C9A84C;
}
.admin-post-featured { margin-bottom: 6rem; }

.v2-container { max-width: 1280px; margin: 0 auto; padding: 0 1.5rem; }
.blog-hero {
  position: relative; min-height: 70vh;
  display: flex; flex-direction: column; justify-content: center;
  overflow: hidden; background: #080E17; padding-top: 52px;
}
.blog-hero-bg { position: absolute; inset: 0; }
.blog-hero-bg img { width: 100%; height: 100%; object-fit: cover; opacity: 0.85; filter: contrast(1.05); }
.blog-hero-overlay {
  position: absolute; inset: 0;
  background:
    linear-gradient(to right, rgba(8,14,23,0.88) 30%, rgba(8,14,23,0.15) 100%),
    linear-gradient(to top, rgba(8,14,23,0.75) 0%, transparent 60%);
}
.blog-hero-content { position: relative; z-index: 10; padding: 10rem 1.5rem 5rem; }
.blog-hero-badge {
  display: inline-flex; align-items: center; gap: 0.6rem;
  font-family: 'Outfit', sans-serif; font-size: 0.65rem; font-weight: 700;
  letter-spacing: 3px; text-transform: uppercase; color: #C9A84C;
  border: 1px solid rgba(201,168,76,0.3); padding: 0.4rem 1rem;
  border-radius: 100px; margin-bottom: 2rem;
  opacity: 0; animation: blogFadeUp 0.8s ease-out 0.1s forwards;
}
.v2-badge-dot {
  width: 6px; height: 6px; border-radius: 50%; background: #C9A84C;
  animation: pulse 2s infinite;
}
@keyframes pulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.5; transform: scale(1.3); } }
.blog-hero-title {
  display: flex; flex-direction: column; font-family: 'Outfit', sans-serif;
  font-size: clamp(2.5rem, 6vw, 5rem); font-weight: 800; line-height: 1;
  letter-spacing: -2px; text-transform: uppercase; margin: 0 0 1.5rem; color: #fff;
}
.blog-title-line { opacity: 0; transform: translateY(30px); animation: blogFadeUp 0.8s ease-out forwards; }
.blog-title-accent { color: #C9A84C; }
.blog-title-stroke { -webkit-text-stroke: 2px #fff; color: transparent; }
.blog-hero-sub {
  font-family: 'Cormorant Garamond', serif; font-style: italic;
  font-size: clamp(1rem, 1.8vw, 1.25rem); color: rgba(240,234,216,0.7);
  line-height: 1.6; max-width: 520px; margin-bottom: 2rem;
  opacity: 0; animation: blogFadeUp 0.8s ease-out 0.65s forwards;
}
@keyframes blogFadeUp { to { opacity: 1; transform: translateY(0); } }

.blog-section { padding: 6rem 0; background: #fff; position: relative; }
.blog-section::before {
  content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
  background: linear-gradient(to right, #C9A84C, transparent);
}
.blog-featured-post {
  display: grid; grid-template-columns: 1.2fr 1fr; gap: 4rem;
  background: rgba(8,14,23,0.02); border: 1px solid rgba(8,14,23,0.05);
  border-radius: 16px; overflow: hidden; align-items: center;
}
.blog-featured-img { aspect-ratio: 16/10; width: 100%; overflow: hidden; }
.blog-featured-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.8s ease; }
.blog-featured-post:hover .blog-featured-img img { transform: scale(1.03); }
.blog-featured-text { padding: 3rem; display: flex; flex-direction: column; justify-content: center; }
.blog-post-meta { display: flex; align-items: center; gap: 1rem; margin-bottom: 1.25rem; flex-wrap: wrap; }
.blog-post-tag {
  font-family: 'Outfit', sans-serif; font-size: 0.58rem; font-weight: 700;
  letter-spacing: 2px; text-transform: uppercase; color: #C9A84C;
