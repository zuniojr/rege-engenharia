/* TOASTER */
.blog-toast {
  position: fixed;
  bottom: 24px;
  right: 24px;
  background: #0D1624;
  color: #fff;
  border: 1px solid #C9A84C;
  border-radius: 8px;
  padding: 0.8rem 1.4rem;
  font-size: 0.9rem;
  font-weight: 600;
  box-shadow: 0 10px 25px rgba(0,0,0,0.5);
  z-index: 100001;
}

@media (max-width: 900px) {
  .blog-featured-post { grid-template-columns: 1fr; gap: 0; }
  .blog-featured-text { padding: 2.5rem; }
  .blog-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 600px) {
  .blog-hero-content { padding: 8rem 1rem 4rem; }
  .blog-grid { grid-template-columns: 1fr; }
  .admin-topbar-links { gap: 0.5rem; }
  .admin-topbar-btn { font-size: 0.65rem; padding: 0.4rem 0.6rem; }
  .admin-blog-filter-bar { flex-direction: column; }
  .form-row { flex-direction: column; gap: 0; }
}

.v2-reveal { opacity: 0; transform: translateY(24px); transition: opacity 0.7s ease, transform 0.7s ease; }
.v2-reveal.visible { opacity: 1; transform: translateY(0); }
.v2-reveal-delay-1 { transition-delay: 0.1s; }
.v2-reveal-delay-2 { transition-delay: 0.2s; }
</style>

<script>
  // Scroll reveal
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('visible');
        obs.unobserve(e.target);
      }
    });
  }, { threshold: 0.05, rootMargin: '0px 0px -40px 0px' });
  document.querySelectorAll('.v2-reveal').forEach(el => obs.observe(el));

  // FILTROS DE PESQUISA
  const searchInput = document.getElementById('post-search');
  const tagSelect = document.getElementById('tag-filter');
  const cards = document.querySelectorAll('.admin-post-wrapper');

  function filterPosts() {
    const q = (searchInput?.value || '').toLowerCase().trim();
    const tag = (tagSelect?.value || '').trim();

    cards.forEach(card => {
      const cardTitle = card.getAttribute('data-title') || '';
      const cardSlug = card.getAttribute('data-slug') || '';
      const cardTag = card.getAttribute('data-tag') || '';

      const matchesQuery = !q || cardTitle.includes(q) || cardSlug.includes(q);
      const matchesTag = !tag || cardTag === tag;

      if (matchesQuery && matchesTag) {
        card.style.display = '';
      } else {
        card.style.display = 'none';
      }
    });
  }

  searchInput?.addEventListener('input', filterPosts);
  tagSelect?.addEventListener('change', filterPosts);

  // MODAL DE EDIÇÃO NATIVO
  const modal = document.getElementById('article-modal');
  const modalCloseBtn = document.getElementById('modal-close-btn');
  const modalCancelBtn = document.getElementById('modal-cancel-btn');
  const modalForm = document.getElementById('post-edit-form');
  const modalSaveBtn = document.getElementById('modal-save-btn');
  const modalTitle = document.getElementById('modal-post-title');
  const modalSlug = document.getElementById('modal-post-slug');

  const editSlug = document.getElementById('edit-slug');
  const editTitle = document.getElementById('edit-title');
  const editTag = document.getElementById('edit-tag');
  const editImage = document.getElementById('edit-image');
  const editImagePreview = document.getElementById('edit-image-preview');
  const editReadtime = document.getElementById('edit-readtime');
  const editExcerpt = document.getElementById('edit-excerpt');
  const editFeatured = document.getElementById('edit-featured');
  const fileInput = document.getElementById('edit-file-input');
  const uploadStatus = document.getElementById('edit-upload-status');

  const toast = document.getElementById('blog-toast');
  const toastMsg = document.getElementById('blog-toast-msg');

  let currentPostData = null;

  function showToast(msg) {
    if (!toast || !toastMsg) return;
    toastMsg.innerText = msg;
    toast.style.display = 'block';
    setTimeout(() => { toast.style.display = 'none'; }, 3500);
  }

  function closeModal() {
    if (modal) modal.style.display = 'none';
    currentPostData = null;
  }

  modalCloseBtn?.addEventListener('click', closeModal);
  modalCancelBtn?.addEventListener('click', closeModal);

  // Abertura do modal ao clicar em "Editar Artigo"
  document.querySelectorAll('.admin-edit-btn-modal').forEach(btn => {
    btn.addEventListener('click', async () => {
      const slug = btn.getAttribute('data-slug');
      if (!slug) return;

      btn.innerText = 'Carregando...';

      try {
        const res = await fetch(`/api/admin/post?slug=${encodeURIComponent(slug)}`);
        const data = await res.json();

        if (data.success && data.post) {
          currentPostData = data.post;
          if (editSlug) editSlug.value = data.post.slug || slug;
          if (modalTitle) modalTitle.innerText = `Editar Artigo`;
          if (modalSlug) modalSlug.innerText = data.post.slug || slug;

          if (editTitle) editTitle.value = data.post.title || '';
          if (editTag) editTag.value = data.post.tag || '';
          if (editImage) editImage.value = data.post.image || '';
          if (editImagePreview) editImagePreview.src = data.post.image || '';
          if (editReadtime) editReadtime.value = data.post.readTime || '';
          if (editExcerpt) editExcerpt.value = data.post.excerpt || '';
          if (editFeatured) editFeatured.checked = !!data.post.featured;

          if (modal) modal.style.display = 'flex';
        } else {
          alert('Erro ao carregar dados do artigo.');
        }
      } catch (err) {
        alert('Erro ao conectar ao servidor.');
      } finally {
        btn.innerHTML = `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg> Editar Artigo`;
      }
    });
  });

  // Atualização em tempo real da prévia da imagem ao digitar URL
  editImage?.addEventListener('input', () => {
    if (editImagePreview) editImagePreview.src = editImage.value;
  });

  // Upload de Imagem
  fileInput?.addEventListener('change', async (e) => {
    const file = e.target.files?.[0];
    if (!file) return;

    if (uploadStatus) uploadStatus.innerText = 'Enviando imagem...';
    const formData = new FormData();
    formData.append('file', file);

    try {
      const res = await fetch('/api/admin/upload', {
        method: 'POST',
        body: formData,
      });
      const data = await res.json();
      if (data.success && data.url) {
        if (editImage) editImage.value = data.url;
        if (editImagePreview) editImagePreview.src = data.url;
        if (uploadStatus) uploadStatus.innerText = 'Upload concluído com sucesso!';
        showToast('Imagem carregada com sucesso!');
      } else {
        if (uploadStatus) uploadStatus.innerText = `Erro: ${data.message || 'Falha no upload'}`;
      }
    } catch (err) {
      if (uploadStatus) uploadStatus.innerText = 'Erro ao conectar ao servidor.';
    }
  });

  // Submissão do formulário de edição
  modalForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!currentPostData) return;

    if (modalSaveBtn) modalSaveBtn.innerHTML = '<span>Salvando no GitHub...</span>';

    const slug = editSlug.value;
    const updatedPost = {
      ...currentPostData,
      title: editTitle.value,
      tag: editTag.value,
      image: editImage.value,
      readTime: editReadtime.value,
      excerpt: editExcerpt.value,
      featured: editFeatured.checked,
    };

    try {
      const res = await fetch('/api/admin/post', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          slug,
          postData: updatedPost,
          commitMessage: `chore(blog): atualizar artigo "${updatedPost.title}" via Admin Visual`,
        }),
      });

      const data = await res.json();
      if (data.success) {
        showToast('Artigo salvo e comitado com sucesso!');
        closeModal();
        setTimeout(() => { window.location.reload(); }, 1200);
      } else {
        alert(`Erro ao salvar: ${data.message || 'Falha na persistência'}`);
      }
    } catch (err) {
      alert('Erro de conexão ao salvar artigo.');
    } finally {
      if (modalSaveBtn) {
        modalSaveBtn.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L20 7"/></svg> <span>Salvar Alterações</span>`;
      }
    }
  });
</script>

</body>
</html>
