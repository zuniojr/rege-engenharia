---
export const prerender = false;

import { isRequestAuthenticated } from '../../lib/admin/auth';
import { blogPosts } from '../../data/blogPosts.js';

const isAuthenticated = isRequestAuthenticated(Astro.request);

// Estatísticas
const totalPosts = blogPosts.length;
const featuredPost = blogPosts.find(p => p.featured);
const recentPosts = blogPosts.slice(0, 6);

// Páginas gerenciáveis
const pagesList = [
  { name: 'Página Inicial (Home)', slug: 'home', path: '/', status: 'Ativo' },
  { name: 'Quem Somos (Sobre)', slug: 'sobre', path: '/sobre', status: 'Ativo' },
  { name: 'Serviços de Engenharia', slug: 'servicos', path: '/servicos', status: 'Ativo' },
  { name: 'Obras Residenciais', slug: 'obra-residencial', path: '/obra-residencial', status: 'Ativo' },
  { name: 'Obras Comerciais', slug: 'obra-comercial', path: '/obra-comercial', status: 'Ativo' },
  { name: 'Regularização Imobiliária', slug: 'regularizacao-imobiliaria', path: '/regularizacao-imobiliaria', status: 'Ativo' },
  { name: 'Portfólio de Obras', slug: 'portfolio', path: '/portfolio', status: 'Ativo' },
];
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Painel Administrativo | Regê Engenharia</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
</head>
<body>

{!isAuthenticated ? (
  <!-- TELA DE LOGIN -->
  <div class="login-wrapper">
    <div class="login-card">
      <div class="login-brand">
        <svg width="40" height="40" viewBox="0 0 36 36" fill="none">
          <rect width="36" height="36" rx="8" fill="#C9A84C"/>
          <path d="M10 26V10h6.5c2.5 0 4.5 2 4.5 4.5S19 19 16.5 19H10M18 26l5-8" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span>Regê Engenharia</span>
      </div>
      <h2>Painel Administrativo</h2>
      <p>Digite a senha mestra para gerenciar o conteúdo e editar visualmente as páginas.</p>

      <form id="login-form" class="login-form">
        <div class="form-group">
          <label for="password">Senha de Acesso</label>
          <input type="password" id="password" name="password" placeholder="••••••••" required autofocus />
        </div>
        <div id="login-error" class="login-error" style="display: none;"></div>
        <button type="submit" id="btn-submit" class="btn-primary">Entrar no Painel</button>
      </form>
    </div>
  </div>
) : (
  <!-- PAINEL COMPLETO -->
  <div class="admin-layout">
    <!-- BARRA LATERAL -->
    <aside class="admin-sidebar">
      <div class="sidebar-brand">
        <svg width="28" height="28" viewBox="0 0 36 36" fill="none">
          <rect width="36" height="36" rx="8" fill="#C9A84C"/>
          <path d="M10 26V10h6.5c2.5 0 4.5 2 4.5 4.5S19 19 16.5 19H10M18 26l5-8" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <div>
          <span class="brand-title">Regê Admin</span>
          <span class="brand-sub">Sistema Visual</span>
        </div>
      </div>

      <nav class="sidebar-nav">
        <a href="/admin" class="nav-item active">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
          <span>Visão Geral</span>
        </a>
        <a href="#paginas" class="nav-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/><path d="M6 6h10"/><path d="M6 10h10"/></svg>
          <span>Páginas do Site</span>
        </a>
        <a href="/admin/blog" class="nav-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
          <span>Artigos do Blog ({totalPosts})</span>
        </a>
        <a href="/keystatic" target="_blank" class="nav-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
          <span>Keystatic CMS</span>
        </a>
      </nav>

      <div class="sidebar-footer">
        <a href="/" target="_blank" class="nav-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          <span>Ver Site no Ar</span>
        </a>
        <a href="/admin/logout" class="nav-item nav-item-danger">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          <span>Sair</span>
        </a>
      </div>
    </aside>

    <!-- CONTEÚDO PRINCIPAL -->
    <main class="admin-main">
      <header class="main-header">
        <div>
          <h1>Painel Geral</h1>
          <p>Gerencie o conteúdo institucional e os artigos com edição visual em tempo real.</p>
        </div>
        <div class="header-actions">
          <a href="/" target="_blank" class="btn-gold-action">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            <span>Editar Página Inicial com Lápis</span>
          </a>
        </div>
      </header>

      <!-- CARDS DE MÉTRICAS -->
      <section class="metrics-grid">
        <div class="metric-card">
          <div class="metric-icon gold">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/><path d="M6 6h10"/><path d="M6 10h10"/></svg>
          </div>
          <div>
            <span class="metric-label">Páginas Institucionais</span>
            <strong class="metric-val">{pagesList.length}</strong>
          </div>
        </div>

        <div class="metric-card">
          <div class="metric-icon blue">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
          </div>
          <div>
            <span class="metric-label">Artigos do Blog</span>
            <strong class="metric-val">{totalPosts}</strong>
          </div>
        </div>

        <div class="metric-card">
          <div class="metric-icon green">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          </div>
          <div>
            <span class="metric-label">Status do Repositório</span>
            <strong class="metric-val">GitHub / Vercel Ativo</strong>
          </div>
        </div>
      </section>

      <!-- TABELA DE PÁGINAS EDITÁVEIS -->
      <section class="section-box" id="paginas">
        <div class="section-box-header">
          <div>
            <h2>Páginas do Site com Edição Visual</h2>
            <p>Abra qualquer página para editar títulos, parágrafos, botões e imagens clicando no lápis correspondente.</p>
          </div>
        </div>

        <div class="table-responsive">
          <table class="admin-table">
            <thead>
              <tr>
                <th>Nome da Página</th>
                <th>URL Pública</th>
                <th>Status</th>
                <th>Ações</th>
              </tr>
            </thead>
            <tbody>
              {pagesList.map(page => (
                <tr>
                  <td>
                    <strong>{page.name}</strong>
                  </td>
                  <td><code>{page.path}</code></td>
                  <td><span class="badge badge-success">{page.status}</span></td>
                  <td>
                    <a href={page.path} target="_blank" class="btn-table-action">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                      <span>Abrir com Lápis</span>
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- ARTIGOS RECENTES -->
      <section class="section-box">
        <div class="section-box-header">
          <div>
            <h2>Artigos do Blog</h2>
            <p>Visualização rápida dos últimos artigos publicados no repositório.</p>
          </div>
          <a href="/admin/blog" class="btn-table-action">Ver Todos os {totalPosts} Posts</a>
        </div>

        <div class="table-responsive">
          <table class="admin-table">
            <thead>
              <tr>
                <th>Artigo</th>
                <th>Categoria / Tag</th>
                <th>Tempo</th>
                <th>Ação</th>
              </tr>
            </thead>
            <tbody>
              {recentPosts.map(post => (
                <tr>
                  <td>
                    <strong>{post.title}</strong>
                    <div class="text-muted">{post.slug}</div>
                  </td>
                  <td><span class="badge badge-tag">{post.tag}</span></td>
                  <td>{post.readTime}</td>
                  <td>
                    <a href={`/blog/${post.slug}`} target="_blank" class="btn-table-action">Visualizar Post</a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    </main>
  </div>
)}

<style>
  :root {
    --bg-dark: #090E17;
    --bg-card: #111A28;
    --border: rgba(255,255,255,0.08);
    --gold: #C9A84C;
    --gold-hover: #DFBC5E;
    --text-white: #F8FAFC;
    --text-muted: #94A3B8;
  }

  body {
    margin: 0;
    font-family: 'Outfit', sans-serif;
    background: var(--bg-dark);
    color: var(--text-white);
  }

  /* LOGIN */
  .login-wrapper {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    background: radial-gradient(circle at top center, #17243A 0%, var(--bg-dark) 70%);
  }

  .login-card {
    background: var(--bg-card);
    border: 1px solid rgba(201,168,76,0.3);
    border-radius: 12px;
    padding: 2.5rem;
    width: 100%;
    max-width: 420px;
    box-shadow: 0 25px 60px rgba(0,0,0,0.6);
  }

  .login-brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--gold);
    margin-bottom: 1.5rem;
  }

  .login-card h2 {
    margin: 0 0 0.5rem;
    font-size: 1.5rem;
  }

  .login-card p {
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.5;
    margin-bottom: 1.75rem;
  }

  .form-group {
    margin-bottom: 1.25rem;
  }

  .form-group label {
    display: block;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: #CBD5E1;
  }

  .form-group input {
    width: 100%;
    background: #060A10;
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 6px;
    padding: 0.8rem 1rem;
    color: #fff;
    font-size: 1rem;
    box-sizing: border-box;
    transition: border-color 0.2s ease;
  }

  .form-group input:focus {
    outline: none;
    border-color: var(--gold);
  }

  .btn-primary {
    width: 100%;
    background: var(--gold);
    color: #090E17;
    font-weight: 700;
    border: none;
    border-radius: 6px;
    padding: 0.85rem;
    cursor: pointer;
    font-size: 0.95rem;
    transition: background 0.2s ease;
  }

  .btn-primary:hover {
    background: var(--gold-hover);
  }

  .login-error {
    background: rgba(239, 68, 68, 0.15);
    border: 1px solid rgba(239, 68, 68, 0.4);
    color: #F87171;
    padding: 0.6rem 0.9rem;
    border-radius: 6px;
    font-size: 0.85rem;
    margin-bottom: 1.25rem;
  }

  /* LAYOUT ADMIN */
  .admin-layout {
    display: flex;
    min-height: 100vh;
  }

  .admin-sidebar {
    width: 260px;
    background: #0D1624;
    border-right: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    padding: 1.5rem 1rem;
  }

  .sidebar-brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0 0.5rem 1.5rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 1.5rem;
  }

  .brand-title {
    display: block;
    font-weight: 700;
    font-size: 1.05rem;
    color: #fff;
  }

  .brand-sub {
    font-size: 0.75rem;
    color: var(--gold);
  }

  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    flex: 1;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    border-radius: 6px;
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    transition: all 0.2s ease;
  }

  .nav-item:hover, .nav-item.active {
    background: rgba(201,168,76,0.12);
    color: var(--gold);
  }

  .nav-item-danger:hover {
    background: rgba(239, 68, 68, 0.15);
    color: #EF4444;
  }

  .sidebar-footer {
    border-top: 1px solid var(--border);
    padding-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  /* MAIN CONTENT */
  .admin-main {
    flex: 1;
    padding: 2.5rem 3rem;
    overflow-y: auto;
  }

  .main-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2.5rem;
  }

  .main-header h1 {
    margin: 0 0 0.25rem;
    font-size: 2rem;
  }

  .main-header p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .btn-gold-action {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--gold);
    color: #090E17;
    font-weight: 700;
    font-size: 0.9rem;
    padding: 0.75rem 1.25rem;
    border-radius: 8px;
    text-decoration: none;
    transition: background 0.2s ease;
  }

  .btn-gold-action:hover {
    background: var(--gold-hover);
  }

  /* METRICS */
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .metric-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.5rem;
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .metric-icon {
    width: 48px;
    height: 48px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .metric-icon.gold { background: rgba(201,168,76,0.15); color: var(--gold); }
  .metric-icon.blue { background: rgba(59, 130, 246, 0.15); color: #3B82F6; }
  .metric-icon.green { background: rgba(16, 185, 129, 0.15); color: #10B981; }

  .metric-label {
    display: block;
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-bottom: 0.25rem;
  }

  .metric-val {
    font-size: 1.5rem;
    font-weight: 700;
  }

  /* SECTION BOX */
  .section-box {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 2rem;
    margin-bottom: 2.5rem;
  }

  .section-box-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }

  .section-box-header h2 {
    margin: 0 0 0.25rem;
    font-size: 1.3rem;
  }

  .section-box-header p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.88rem;
  }

  /* TABLES */
  .table-responsive {
    overflow-x: auto;
  }

  .admin-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: 0.9rem;
  }

  .admin-table th {
    padding: 0.85rem 1rem;
    color: var(--text-muted);
    font-weight: 600;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    border-bottom: 1px solid var(--border);
  }

  .admin-table td {
    padding: 1rem;
    border-bottom: 1px solid var(--border);
    vertical-align: middle;
  }

  .admin-table tr:hover td {
    background: rgba(255,255,255,0.02);
  }

  .badge {
    display: inline-block;
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .badge-success { background: rgba(16, 185, 129, 0.15); color: #10B981; }
  .badge-tag { background: rgba(201,168,76,0.15); color: var(--gold); }

  .btn-table-action {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1);
    color: #fff;
    padding: 0.45rem 0.85rem;
    border-radius: 6px;
    font-size: 0.82rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-table-action:hover {
    background: var(--gold);
    color: #090E17;
    border-color: var(--gold);
  }

  .text-muted {
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  @media (max-width: 900px) {
    .admin-layout { flex-direction: column; }
    .admin-sidebar { width: 100%; box-sizing: border-box; }
    .admin-main { padding: 1.5rem; }
  }
</style>

<script is:inline>
  const loginForm = document.getElementById('login-form');
  const errorBox = document.getElementById('login-error');
  const btnSubmit = document.getElementById('btn-submit');

  loginForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (errorBox) errorBox.style.display = 'none';
    if (btnSubmit) btnSubmit.innerText = 'Verificando...';

    const password = document.getElementById('password')?.value;

    try {
      const res = await fetch('/api/admin/auth', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ password }),
      });
      const data = await res.json();
      if (data.success) {
        window.location.reload();
      } else {
        if (errorBox) {
          errorBox.innerText = data.message || 'Senha incorreta.';
          errorBox.style.display = 'block';
        }
        if (btnSubmit) btnSubmit.innerText = 'Entrar no Painel';
      }
    } catch (err) {
      if (errorBox) {
        errorBox.innerText = 'Erro de conexão com o servidor.';
        errorBox.style.display = 'block';
      }
      if (btnSubmit) btnSubmit.innerText = 'Entrar no Painel';
    }
  });
</script>

</body>
</html>
